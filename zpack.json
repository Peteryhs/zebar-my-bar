{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.0.0/resources/zpack-schema.json",
  "name": "my-bar",
  "version": "0.0.0",
  "description": "A basic widget pack for testing and development.",
  "tags": [
    "topbar"
  ],
  "previewImages": [
    "./resources/preview-image-1.png"
  ],
  "repositoryUrl": "",
  "widgets": [
    {
      "name": "vanilla",
      "htmlPath": "./vanilla.html",
      "zOrder": "top_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "*.html",
        "*.css",
        "assets/*",
        "*.woff2",
        "assets/**",
        "scripts/*"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": [
          {
            "urlRegex": "api\\.open-meteo\\.com",
            "duration": 900
          },
          {
            "urlRegex": "ipinfo\\.io",
            "duration": 86400
          }
        ]
      },
      "privileges": {
        "shellCommands": [
          {
            "program": "powershell.exe",
            "argsRegex": "-NoProfile( -ExecutionPolicy Bypass)? -File .*\\\\(window-ctl|brightness)\\.ps1"
          }
        ]
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_left",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "42px",
          "monitorSelection": {
            "type": "all"
          },
          "dockToEdge": {
            "enabled": true,
            "edge": "top",
            "windowMargin": "0px"
          }
        }
      ]
    },
